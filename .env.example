# Base de datos PostgreSQL
# En Supabase:
# DATABASE_URL: Conexión con pooler (puerto 6543, pgbouncer=true)
# DIRECT_URL: Conexión directa (puerto 5432) para DDL / migraciones / creación de schemas
#
# Para desarrollo local (Docker Compose):
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/despacho_db?schema=public"
DIRECT_URL="postgresql://postgres:postgrespassword@localhost:5432/despacho_db?schema=public"

# Clave secreta para firma y verificación de JWT (mínimo 32 caracteres)
JWT_SECRET="despacho-super-secret-jwt-key-min-32-chars-2026"

# URL pública de la aplicación
NEXT_PUBLIC_APP_URL="http://localhost:3000"
