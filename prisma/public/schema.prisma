generator client {
  provider      = "prisma-client-js"
  output        = "../../generated/public-client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id         String   @id @default(cuid())
  name       String
  schemaName String   @unique @map("schema_name")
  createdAt  DateTime @default(now()) @map("created_at")
  users      User[]

  @@map("tenants")
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String   @map("password_hash")
  nombre           String?
  role             String   @default("admin") // "socio", "senior", "junior", "admin"
  experienciaAnios Int      @default(0) @map("experiencia_anios")
  tenantId         String   @map("tenant_id")
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("users")
}

model IdempotencyKey {
  id           String   @id @default(cuid())
  scope        String   // tenantId, o "anon" para el registro
  key          String
  endpoint     String
  requestHash  String   @map("request_hash")
  status       String   @default("in_progress") // in_progress | completed
  responseCode Int?     @map("response_code")
  responseBody Json?    @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at")
  expiresAt    DateTime @map("expires_at")

  @@unique([scope, key, endpoint])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model RateLimitHit {
  id        BigInt   @id @default(autoincrement())
  bucket    String   // ej. "login:ip:1.2.3.4:email", "create:tenant:abc"
  createdAt DateTime @default(now()) @map("created_at")

  @@index([bucket, createdAt])
  @@map("rate_limit_hits")
}
